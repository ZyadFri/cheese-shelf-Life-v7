# Copy to backend/.env (or export these in your shell) before starting the
# FastAPI backend. Only LLM_PROVIDER plus that provider's own vars are
# needed; every other provider's vars can stay blank.

# Five providers, switch with LLM_PROVIDER (no other code changes needed):
#
# gemini     (cloud, Google AI Studio -- recommended production default.
#             Free tier as of writing: gemini-2.5-flash at 15 requests/min,
#             1,500 requests/day; gemini-2.5-flash-lite trades some quality
#             for a higher free daily request limit if 2.5-flash's RPM is
#             the bottleneck. Reliable structured tool calling.)
# cerebras   (cloud, very low latency thanks to Cerebras' wafer-scale
#             hardware. Free tier as of writing: 1M tokens/day, 14,400
#             requests/day, 30 requests/min, 8K context cap on the free
#             tier. Good fallback/comparison option.)
# cloudflare (cloud, Cloudflare Workers AI. Free tier as of writing: 10,000
#             Neurons/day -- a compute-time budget that is small in
#             practice, so this is best used as a fallback rather than the
#             sole production provider. Tool-calling support is
#             model-dependent; the default below is confirmed to support it.)
# groq       (cloud, ~1-3s/turn, needs a free API key from console.groq.com/keys;
#             fast, but the free tier's tokens-per-minute quota is tight for
#             a tool-heavy system prompt -- kept for comparison/fallback.)
# ollama     (fully local/private, no API key, but slow on CPU -- ~10-90s/turn
#             with the default qwen3:8b; smaller qwen3 variants were tested
#             and rejected because they don't reliably use structured tool
#             calls, which breaks the "never invent numbers" guarantee.
#             Useful for local development; not required for production.)
#
# Only the chat text (and tool-call arguments/results) is ever sent to
# whichever cloud provider is configured -- your data/models/predictions
# stay local either way; the provider never sees your dataset directly,
# only what a tool result reports back for that one turn.

LLM_PROVIDER=gemini

# Optional: comma-separated providers to try, in order, ONLY when the
# primary provider fails with an infra/quota error (429, timeout,
# unavailable, temporary 5xx) -- never for normal requests, and never as a
# fan-out to multiple providers at once. Leave blank to disable fallback.
# Example: LLM_FALLBACK_PROVIDERS=cerebras,groq
LLM_FALLBACK_PROVIDERS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Assistant tuning (optional -- sensible defaults are already baked in):
# ASSISTANT_MAX_TOOL_ROUNDS=1
# ASSISTANT_MAX_HISTORY_MESSAGES=12
